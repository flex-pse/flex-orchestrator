[importlinter]
root_packages =
    flexorchestrator
include_external_packages = True

# The package's layering. The HTTP service belongs to a host application, never
# to this library.

[importlinter:contract:no-http-in-core]
name = the library never imports HTTP frameworks, web servers or JWT libraries
type = forbidden
source_modules =
    flexorchestrator
forbidden_modules =
    fastapi
    starlette
    uvicorn
    jwt

[importlinter:contract:format-agnostic-core]
name = hooks, specs, errors, testing and the config models don't import pyomo, flex-pse or Acquirium
type = forbidden
# The plugin-test helpers build an orchestrator only when called; the fake
# hooks and specs stay importable without pyomo.
ignore_imports =
    flexorchestrator.testing.orchestrators -> flexorchestrator.backend
    flexorchestrator.testing.orchestrators -> flexorchestrator.ext
source_modules =
    flexorchestrator.hooks
    flexorchestrator.specs
    flexorchestrator.errors
    flexorchestrator.testing
    flexorchestrator.study.config
    flexorchestrator.fitting.models
    flexorchestrator.inputs.models
    flexorchestrator.inputs.scopes
    flexorchestrator.ext.commands
    flexorchestrator.ext.events
forbidden_modules =
    pyomo
    flexcore
    flexdesign
    flexops
    flexparameterize
    acquirium

[importlinter:contract:exporter-pyomo-only]
name = the exporter depends only on pyomo, not flex-pse or Acquirium
type = forbidden
source_modules =
    flexorchestrator.export
forbidden_modules =
    flexcore
    flexdesign
    flexops
    flexparameterize
    acquirium

[importlinter:contract:acquirium-only-in-backend]
name = only backend.acquirium and connection talk to Acquirium; the orchestrator uses hooks, not flex-pse
type = forbidden
# The orchestrator reaches Acquirium only through connection.connect,
# which imports Acquirium lazily and builds the backend.
ignore_imports =
    flexorchestrator.orchestrator -> flexorchestrator.connection
source_modules =
    flexorchestrator.orchestrator
    flexorchestrator.results
    flexorchestrator.backend.base
    flexorchestrator.backend.memory
    flexorchestrator.backend.files
    flexorchestrator.ext
    flexorchestrator.fitting
    flexorchestrator.inputs
    flexorchestrator.study
    flexorchestrator.archive
    flexorchestrator.cli
    flexorchestrator.parallel
    flexorchestrator.verify
    flexorchestrator.service
forbidden_modules =
    acquirium
    requests
    flexcore
    flexdesign
    flexops
    flexparameterize
