    "/studies/{study}/results": {
      "get": {
        "description": "The study's results as D17 result files, ``limit`` at a time.\n\nReturns ``{\"results\": {tag: ResultFile}, \"total\", \"next\"}``; ``next`` is\nthe ``offset`` of the next page, or ``null`` after the last.",
        "operationId": "list_results",
        "parameters": [
          {
            "in": "path",
            "name": "study",
            "required": true,
            "schema": {
              "title": "Study",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tags"
            }
          },
