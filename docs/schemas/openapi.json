            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Cancel Job",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Job",
        "tags": [
          "commands"
        ]
      },
      "get": {
        "description": "A job's status, progress, result or error; 404 if there's none.",
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Job",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job",
        "tags": [
          "commands"
        ]
      }
    },
    "/jobs/{job_id}/events": {
      "get": {
        "description": "A job's progress as Server-Sent Events, until it finishes.\n\nEach change of the job is an ``event: progress`` whose data is the job, as\n``GET /jobs/{id}`` returns it; the last is ``event: done``. Browsers'\n``EventSource`` can't send a bearer token, so read it with ``fetch`` (a\nstreamed response).",
        "operationId": "job_events",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job Events",
        "tags": [
          "commands"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the store answers. Needs no token.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/studies": {
      "get": {
        "description": "The tenant's studies.",
        "operationId": "list_studies",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Studies",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Studies",
        "tags": [
          "studies"
        ]
      },
      "post": {
        "description": "Create a study; 409 if it exists.",
        "operationId": "create_study",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewStudy"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Study",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Study",
        "tags": [
          "studies"
        ]
      }
    },
    "/studies/import": {
      "post": {
        "description": "Import an export zip as a study: ``202 {\"job_id\"}``.\n\nThe zip is unpacked now (refused if it's too large or names a path outside\nitself); the import, with its checksum checks, runs on the job queue.",
        "operationId": "import_study",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_study"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Study",
        "tags": [
          "export"
        ]
      }
    },
    "/studies/{study}": {
      "delete": {
        "description": "Delete a study and everything in it, for good (D9).",
        "operationId": "delete_study",
        "parameters": [
          {
            "in": "path",
            "name": "study",
            "required": true,
            "schema": {
              "title": "Study",
              "type": "string"
            }
          }
        ],
        "responses": {
