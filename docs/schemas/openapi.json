                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Data",
        "tags": [
          "studies"
        ]
      },
      "post": {
        "description": "Store a dataset; 409 if the name is taken (unless ``replace``).",
        "operationId": "store_data",
        "parameters": [
          {
            "in": "path",
            "name": "name",
