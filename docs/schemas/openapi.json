                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Data",
        "tags": [
          "studies"
        ]
      }
    },
    "/studies/{study}/data/{name}": {
      "get": {
        "description": "A dataset, as its D17 file (``DatasetFile``); 404 if there's none.",
        "operationId": "get_data",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "study",
            "required": true,
            "schema": {
              "title": "Study",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "columns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Columns"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
