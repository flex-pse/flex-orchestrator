{
  "components": {
    "schemas": {
      "Body_import_study": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "a zip of a D17 export folder",
            "title": "File",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "on_existing": {
            "default": "error",
            "enum": [
              "error",
              "skip"
            ],
            "title": "On Existing",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_import_study",
        "type": "object"
      },
      "DataColumn": {
        "additionalProperties": false,
        "description": "One column of an uploaded dataset.",
        "properties": {
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "values"
        ],
        "title": "DataColumn",
        "type": "object"
      },
      "DataIn": {
        "additionalProperties": false,
        "description": "``POST /studies/{s}/data/{name}``: a dataset, as the D17 file has it.\n\nAttributes:\n    time_index: Timestamps, ISO 8601; naive means UTC.\n    columns: ``{column: {unit, values}}``, one value per timestamp.\n    replace: Replace a stored dataset with this name.",
        "properties": {
          "columns": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DataColumn"
            },
            "minProperties": 1,
            "title": "Columns",
            "type": "object"
          },
          "replace": {
            "default": false,
            "title": "Replace",
            "type": "boolean"
          },
          "time_index": {
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "title": "Time Index",
            "type": "array"
          }
        },
        "required": [
          "time_index",
          "columns"
        ],
        "title": "DataIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NewStudy": {
        "additionalProperties": false,
        "description": "``POST /studies``.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "NewStudy",
        "type": "object"
      },
      "SpecIn": {
        "additionalProperties": false,
        "description": "``POST /studies/{s}/specs/{kind}/{tag}``.\n\nAttributes:\n    spec: The spec, as JSON, each file it references named as in\n        ``files``, or by the stored name its ``parent`` has for it.\n    parent: The spec it's derived from (model specs).\n    spec_format: Its format; detected when omitted.\n    assets: More file references, as JSON pointers (model specs).\n    files: ``{\"<sha256[:12]>/<filename>\": base64}`` for each file the\n        spec references (model specs; at most 64 MiB in all). It's stored\n        as ``assets/<sha256[:12]>-<filename>``, as from Python.\n    replace: Replace a stored spec with this tag.",
        "properties": {
          "assets": {
            "items": {
              "type": "string"
            },
            "title": "Assets",
            "type": "array"
          },
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Files",
            "type": "object"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent"
          },
          "replace": {
            "default": false,
            "title": "Replace",
            "type": "boolean"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          },
          "spec_format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Format"
          }
        },
        "required": [
          "spec"
        ],
        "title": "SpecIn",
        "type": "object"
      },
      "SpecOut": {
        "description": "A stored spec.",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "parent_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Tag"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          },
          "spec_format": {
            "title": "Spec Format",
            "type": "string"
          },
          "spec_hash": {
            "title": "Spec Hash",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          }
        },
        "required": [
          "tag",
          "kind",
          "spec",
          "spec_hash",
          "spec_format"
        ],
        "title": "SpecOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Studies, specs, data, results and commands of one tenant.",
    "title": "flex-orchestrator (tenant)",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/commands": {
      "get": {
        "description": "Every command: built-in and the enabled plugins', with its parameters' schema.",
        "operationId": "list_commands",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Commands",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Commands",
        "tags": [
          "commands"
        ]
      }
    },
    "/commands/{name}": {
      "post": {
        "description": "Run a command: ``202 {\"job_id\"}`` if it's long-running, else its result.\n\nIts ``role`` decides who may (403 otherwise); its params model checks the\nbody (422).",
        "operationId": "run_command",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "the study to select first",
            "in": "query",
            "name": "study",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "the study to select first",
              "title": "Study"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Params",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Run Command"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Command",
        "tags": [
          "commands"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process answers. Needs no token.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/jobs/{job_id}": {
      "delete": {
        "description": "Cancel a queued or running job; a finished one is left as it is.",
        "operationId": "cancel_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
